# ============================================================================
#  MRPL Sovereign Agentic Workbench — core configuration
#
#  Copy to .env and edit.  DO NOT COMMIT .env — it holds real API keys.
#
#  Every value here has a safe default. The defaults ARE the sovereign posture:
#  loopback-only, egress enforced, no network tool, guardrails fail-closed. You
#  only need to set values you want to change. The server refuses to start on a
#  value it cannot make sense of, rather than starting in a half-configured state.
# ============================================================================


# ---------------------------------------------------------------------------
#  Model server (llama.cpp / LM Studio / vLLM — anything OpenAI-compatible)
# ---------------------------------------------------------------------------

# Where the local model is listening. Must be reachable or every run fails.
MODEL_BASE_URL=http://127.0.0.1:8080

# Reported in the banner, the receipt, and /healthz. Cosmetic for llama.cpp,
# required by LM Studio and vLLM, which route on it.
MODEL_ID=qwen2.5-coder-7b-instruct

# Only if your server was started with --api-key.
# MODEL_API_KEY=

# A CPU-bound 7B can take minutes on a long generation. Raise, don't lower.
MODEL_TIMEOUT_MS=120000
MODEL_MAX_RETRIES=2

# llama.cpp prompt-cache reuse. Large speedup across steps of one run, because
# the system prompt and history are re-sent every step.
MODEL_CACHE_PROMPT=true

# Must match the -c / --ctx-size the server was started with. Getting this wrong
# is the most common cause of silent truncation mid-run.
MODEL_CONTEXT_WINDOW=8192

# Tokens held back for the answer. Compaction triggers against what's left.
MODEL_RESERVE_TOKENS=1536

# Set for reproducible output — useful when demoing.
# MODEL_SEED=42


# ---------------------------------------------------------------------------
#  Tool-call protocol
# ---------------------------------------------------------------------------

# auto     probe the server at boot and use native tool calling if it works
# native   force the OpenAI-style "tools" payload
# prompted force the in-prompt <tool_call>{...}</tool_call> protocol
#
# Leave on auto. It probes once at startup and prints which it chose and why.
TOOL_PROTOCOL=auto

# Whether the server accepts GBNF `grammar`. Overwritten by the boot probe when
# TOOL_PROTOCOL=auto. Only used on the malformed-output repair path.
SERVER_SUPPORTS_GRAMMAR=true
USE_GRAMMAR_ON_RETRY=true


# ---------------------------------------------------------------------------
#  HTTP server
# ---------------------------------------------------------------------------

PORT=8787

# Loopback by default. If you change this to 0.0.0.0 you MUST set API_TOKEN —
# the server refuses to start otherwise, because the agent can write files and
# an unauthenticated network-exposed endpoint would be a remote shell.
HTTP_HOST=127.0.0.1

# Bearer token for every route except /healthz. Minimum 16 characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API_TOKEN=

# Browser origins allowed to call the API. Empty means no CORS headers at all.
# CORS_ORIGINS=http://localhost:5173

MAX_INPUT_CHARS=32000


# ---------------------------------------------------------------------------
#  Workspace — the only part of the filesystem the agent can touch
# ---------------------------------------------------------------------------

# Absolute path. Every file tool is confined here, including through symlinks.
# Defaults to the process working directory; set it explicitly for a demo so it
# is obvious what the agent can and cannot reach.
WORKSPACE_ROOT=/absolute/path/to/a/demo/workspace


# ---------------------------------------------------------------------------
#  Egress — the sovereignty enforcement point
# ---------------------------------------------------------------------------

# Patches global fetch and refuses any host not permitted below. Turning this
# off makes the air-gap claim false; the banner and /healthz will say so loudly.
EGRESS_ENFORCE=true

# Permit 127.0.0.0/8, localhost and ::1 without listing them. Needed for the
# local model server.
EGRESS_ALLOW_LOOPBACK=true

# Extra hosts, comma-separated, EXACT hostnames — no wildcards, no suffix
# matching ("corp.local" does not admit "evil-corp.local"). The model host is
# added automatically when it is not covered by the loopback exemption; a search
# host is added automatically when search is enabled. Leave empty for air-gapped.
EGRESS_ALLOWLIST=


# ---------------------------------------------------------------------------
#  Guardrails
# ---------------------------------------------------------------------------

# Try to load @llm-guardrails/core. Built-in guards run either way — they are
# the floor, not the fallback, and the strictest verdict wins.
GUARDRAILS_EXTERNAL=true

# relaxed | standard | strict
GUARDRAILS_LEVEL=standard

# A guard that errors or times out BLOCKS. Leave true: a guardrail that fails
# open is not a guardrail.
GUARDRAILS_FAIL_CLOSED=true
GUARDRAILS_TIMEOUT_MS=5000

# Which tool tiers the agent may use. "execute" is deliberately not included.
ALLOWED_TOOL_TIERS=read,write

# Tools to refuse regardless of tier, comma-separated.
# DENIED_TOOLS=web_search

# Extra strings to scrub from tool results and model output. Put project code
# names and internal hostnames here. They are masked in the audit log, not
# printed, so this is safe.
# LEAKAGE_TERMS=Project-Falcon,internal.mrpl.local


# ---------------------------------------------------------------------------
#  Web search — OPTIONAL, and it ends the air-gap
# ---------------------------------------------------------------------------
#  Enabling this registers a tool that sends a query string to a third party.
#  The instance is then NOT air-gapped, /healthz reports airGapped:false, and the
#  banner says so. For the sovereign demo, leave this false.
#
WEB_SEARCH_ENABLED=false
WEB_SEARCH_BACKEND=tavily
# TAVILY_API_KEY=tvly-...

# Google Programmable Search needs both a key and an engine id (cx).
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=

WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
#  Agent loop budgets — the answer to "what stops it running forever"
# ---------------------------------------------------------------------------
MAX_STEPS=12
MAX_TOTAL_TOKENS=60000
MAX_RUN_MS=600000
MAX_TOOL_CALLS_PER_STEP=3

# Identical call repeated this many times ends the run. Small local models get
# stuck in read-the-same-file loops; this is the exit.
REPEAT_CALL_LIMIT=2

# Retries when the model emits unparseable tool JSON, before giving up.
MALFORMED_RETRY_LIMIT=2

# Ask for a plain answer once the step budget is spent, instead of returning
# nothing to the operator.
FORCE_FINAL_ANSWER=true
TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=1024

# Token-by-token streaming from the model. The SSE route enables it per request;
# this is the default for the non-streaming route.
STREAM=false
# Implement for making it work for TRUE

# Compact history once it reaches this fraction of the usable window.
COMPACT_AT_FRACTION=0.75
KEEP_RECENT_MESSAGES=6


# ---------------------------------------------------------------------------
#  Audit — Trust Receipts
# ---------------------------------------------------------------------------
# Where receipts are written. Empty means receipts are still built and returned
# in the API response, just not persisted to disk. Set it for the demo.
AUDIT_DIR=./audit
# Also write the human-readable <runId>.md next to the JSON.
AUDIT_MARKDOWN=true


# ---------------------------------------------------------------------------
#  Logging
# ---------------------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info

NODE_ENV=development
