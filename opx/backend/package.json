{
  "name": "@opx/backend",
  "version": "0.1.0",
  "private": true,
  "description": "OPX sovereign on-premise agentic workbench — multi-model routing, semantic memory, guardrails, trust receipts. Text-to-text. No vendor SDKs, no agent frameworks.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "eventsource-parser": "^4.1.0",
    "express": "^4.21.2",
    "fast-levenshtein": "^3.0.0",
    "gpt-tokenizer": "^4.0.0",
    "jsonrepair": "^3.15.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@llm-guardrails/core": "^0.4.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/node": "^22.10.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.8.0"
  }
}
