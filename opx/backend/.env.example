# ============================================================================
#  OPX Sovereign Agentic Workbench — configuration
#
#  Copy to .env and edit.  DO NOT COMMIT .env — it may hold real API keys.
#
#  Every value here has a safe default. The defaults ARE the sovereign posture:
#  loopback-only, egress enforced, no network tool, guardrails fail-closed. You
#  only need to set values you want to change. The server refuses to start on a
#  value it cannot make sense of, rather than starting half-configured.
#
#  Run it:  node --env-file=.env src/server.ts
# ============================================================================


# ---------------------------------------------------------------------------
#  Default / planner model  (llama.cpp / LM Studio / vLLM — OpenAI-compatible)
#
#  This is the FALLBACK model and the one used for summarisation. When routing
#  is on, each task is sent to the best specialist from the registry below; when
#  no specialist fits, or routing is off, this model handles it.
# ---------------------------------------------------------------------------

MODEL_BASE_URL=http://127.0.0.1:8080
MODEL_ID=qwen2.5-coder-7b-instruct
# MODEL_API_KEY=
MODEL_TIMEOUT_MS=120000
MODEL_MAX_RETRIES=2
MODEL_CACHE_PROMPT=true
MODEL_CONTEXT_WINDOW=8192
MODEL_RESERVE_TOKENS=1536
# MODEL_SEED=42


# ---------------------------------------------------------------------------
#  Multi-model registry  — run several local models and route between them
#
#  All models are local llama.cpp servers, each on its own port. Give the JSON
#  inline in MODELS_JSON, or point MODELS_CONFIG_PATH at a file. If neither is
#  set, the single default model above is used on its own.
#
#  Fields per model: id (required), endpoint (required), role, priority, and
#  optional capabilities. Role fills in sensible capability defaults:
#    general | reasoning | coding | vision | document | multimodal
#  Higher priority wins when several models fit a task.
#
#  Example — a planner, a coder, and a vision/OCR model on three local ports:
# MODELS_JSON=[
#   {"id":"planner","role":"reasoning","endpoint":"http://127.0.0.1:8080","priority":1},
#   {"id":"coder","role":"coding","endpoint":"http://127.0.0.1:8081","priority":2},
#   {"id":"vision","role":"vision","endpoint":"http://127.0.0.1:8082","priority":2}
# ]
# MODELS_CONFIG_PATH=./models.json

# Routing: classify each task and pick the best model. Off = always the default.
ROUTING_ENABLED=true
# The model id used as fallback. Defaults to MODEL_ID above.
# ROUTING_DEFAULT_MODEL=planner


# ---------------------------------------------------------------------------
#  Embedding model  — powers the semantic memory layer
#
#  Another local llama.cpp server, on its own port, serving /v1/embeddings.
#  Load a small fast embedder here (nomic-embed-text, bge-small).
# ---------------------------------------------------------------------------

EMBEDDING_ENABLED=true
EMBEDDING_BASE_URL=http://127.0.0.1:8090
EMBEDDING_MODEL_ID=nomic-embed-text
# EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_MS=30000


# ---------------------------------------------------------------------------
#  Semantic memory  — better answers and dashboards across runs
#
#  Relevant memories are retrieved (by embedding similarity) and injected before
#  each run; the outcome is written back as an episodic memory after. Stored as
#  a plain JSON file — no database, no native modules, air-gap friendly.
# ---------------------------------------------------------------------------

MEMORY_ENABLED=true
# Where the memory JSON store lives.
MEMORY_DIR=./memory-store
# How many memories to retrieve and inject per run.
MEMORY_TOP_K=5
# Minimum cosine similarity (0-1) for a memory to count as relevant.
MEMORY_MIN_SCORE=0.35


# ---------------------------------------------------------------------------
#  Tool-call protocol
# ---------------------------------------------------------------------------

# auto | native | prompted  — leave on auto; it probes the server at boot.
TOOL_PROTOCOL=auto
SERVER_SUPPORTS_GRAMMAR=true
USE_GRAMMAR_ON_RETRY=true


# ---------------------------------------------------------------------------
#  HTTP server
# ---------------------------------------------------------------------------

PORT=8787

# Loopback by default. If you set this to 0.0.0.0 you MUST set API_TOKEN — the
# server refuses to start otherwise, because the agent can write files and an
# unauthenticated network-exposed endpoint would be a remote shell.
HTTP_HOST=127.0.0.1

# Bearer token for every route. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API_TOKEN=

# Browser origins allowed to call the API. Empty means no CORS headers at all.
# CORS_ORIGINS=http://localhost:5173

MAX_INPUT_CHARS=32000


# ---------------------------------------------------------------------------
#  Workspace — the only part of the filesystem the agent can touch
# ---------------------------------------------------------------------------

# Absolute path. Every file tool is confined here, including through symlinks.
WORKSPACE_ROOT=/absolute/path/to/a/demo/workspace


# ---------------------------------------------------------------------------
#  Egress — the sovereignty enforcement point
# ---------------------------------------------------------------------------

# Patches global fetch and refuses any host not permitted below. Turning this
# off makes the air-gap claim false; /healthz will say so.
EGRESS_ENFORCE=true

# Permit 127.0.0.0/8, localhost and ::1 without listing them. Needed for the
# local model, embedding, and memory servers.
EGRESS_ALLOW_LOOPBACK=true

# Extra hosts, comma-separated, EXACT hostnames — no wildcards. Leave empty for
# air-gapped. A search host is added automatically when search is enabled.
EGRESS_ALLOWLIST=


# ---------------------------------------------------------------------------
#  Guardrails
# ---------------------------------------------------------------------------

# Try to load the optional @llm-guardrails/core engine. The built-in guards
# (injection, secrets, tool-policy, protected-paths) run either way — they are
# the floor, not the fallback.
GUARDRAILS_EXTERNAL=true

# relaxed | standard | strict
GUARDRAILS_LEVEL=standard

# A guard that errors or times out BLOCKS. A guardrail that fails open is not a
# guardrail.
GUARDRAILS_FAIL_CLOSED=true
GUARDRAILS_TIMEOUT_MS=5000

# Which tool tiers the agent may use. "execute" is deliberately excluded.
ALLOWED_TOOL_TIERS=read,write

# Tools to refuse regardless of tier, comma-separated.
# DENIED_TOOLS=web_search

# Extra strings to scrub from tool results and model output (project code names,
# internal hostnames). Masked in the audit log, never printed.
# LEAKAGE_TERMS=Project-Falcon,internal.mrpl.local


# ---------------------------------------------------------------------------
#  Web search — OPTIONAL, and it ends the air-gap
# ---------------------------------------------------------------------------

WEB_SEARCH_ENABLED=false
WEB_SEARCH_BACKEND=tavily
# TAVILY_API_KEY=tvly-...
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=15000


# ---------------------------------------------------------------------------
#  Agent loop budgets — what stops it running forever
# ---------------------------------------------------------------------------

MAX_STEPS=12
REPEAT_CALL_LIMIT=2
MALFORMED_RETRY_LIMIT=2
FORCE_FINAL_ANSWER=true
TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=1024
STREAM=false
COMPACT_AT_FRACTION=0.75
KEEP_RECENT_MESSAGES=6


# ---------------------------------------------------------------------------
#  Audit — Trust Receipts
# ---------------------------------------------------------------------------

# Where receipts are written. Empty = still built and returned in the API
# response, just not persisted. Set it for the demo.
AUDIT_DIR=./audit
AUDIT_MARKDOWN=true


# ---------------------------------------------------------------------------
#  Logging
# ---------------------------------------------------------------------------

# trace | debug | info | warn | error
LOG_LEVEL=info
NODE_ENV=development
